MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 983632213}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51d80e9a21aa899429cace3352047a83, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  panelColor: {r: 0.04, g: 0.02, b: 0.02, a: 0.93}
  titleColor: {r: 0.95, g: 0.52, b: 0.12, a: 1}
  bodyColor: {r: 0.84, g: 0.8, b: 0.76, a: 1}
  hintColor: {r: 0.45, g: 0.42, b: 0.4, a: 1}
  panelSize: {x: 700, y: 220}
  panelYOffset: 190
  tutorials:
  - type: 0
    title: Shooting
    body: 'Right-click to aim.

      Left-click to fire.  Press R to reload.

      You
      can only fire while aiming.'
    icon: {fileID: 0}
  - type: 1
    title: Flashlight
    body: "Your flashlight keeps most creatures at bay.\nThe battery drains over
      time \u2014 manage it carefully.\nDarkness is their domain."
    icon: {fileID: 0}
  - type: 2
    title: Flashlight Boost
    body: "Activate a blinding burst of light to repel anything nearby.\nDrains battery
      fast \u2014 save it for emergencies."
    icon: {fileID: 0}
  - type: 3
    title: Trap
    body: Rusty traps take a moment to explode, better run when hit it.
    icon: {fileID: 0}
  - type: 4
    title: Hunter
    body: 'Shine your flashlight to drive it back.


      A single bullet puts it
      down for good.'
    icon: {fileID: 0}
  - type: 5
    title: The Big One
    body: "Light only slows it \u2014 it is not afraid.\nOnly bullets cause real
      damage.\nIt never retreats. Keep your distance and keep shooting."
    icon: {fileID: 0}
  - type: 6
    title: Speedy Creature
    body: "Extremely fast. It will close the gap before you react.\nYour flashlight
      sends it running \u2014 use it early.\nIf it gets close, it's already too late."
    icon: {fileID: 0}
  - type: 7
    title: Checkpoint
    body: 'Walk through to save your progress.

      If you die, you will respawn
      at the last checkpoint.

      Find them. Use them.'
    icon: {fileID: 0}
